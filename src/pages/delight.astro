---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { delightProjects } from '../inhalt';
---

<BaseLayout title="delight | Danio Schneider" activeNav="delight">
  <section class="category-page">
    <div class="container">
      <div class="page-header">
        <h1 class="title-highlight">delight</h1>
        <p class="subtitle">jemanden erfreuen, begeistern oder unterhalten.</p>
      </div>

      <div class="projects-grid">
        {delightProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .category-page {
    padding: 3.5rem 0 2rem;
  }

  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1rem;
    margin-bottom: 2.5rem;
    border-bottom: 1.5px solid var(--black);
  }

  .title-highlight {
    margin: 0;
    font-family: var(--font-highlight);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(3.2rem, 6vw, 4.8rem);
    line-height: 1;
    color: var(--black);
    padding: 0.08em 0.48em 0.14em;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--black);
    background: var(--white);
    transition: all 0.5s var(--ease-fluid);
  }

  .title-highlight:hover {
    background: var(--chrome-pink);
    box-shadow: 0 12px 32px var(--pink-glow);
    transform: translateY(-2px);
  }

  .subtitle {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  @media (max-width: 768px) {
    .category-page {
      padding: 1.75rem 0 1.5rem;
    }

    .page-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.55rem;
      padding-bottom: 0.85rem;
      margin-bottom: 1.5rem;
    }

    .title-highlight {
      font-size: clamp(1.9rem, 8.2vw, 2.5rem);
      line-height: 1.15;
      padding: 0.2rem 0.95rem 0.28rem;
      border-radius: 26px;
      max-width: 100%;
    }

    .subtitle {
      font-size: 0.76rem;
      letter-spacing: 0.1em;
      line-height: 1.45;
    }
  }
</style>
